<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs + FindSecBugs (profile -Psecurity). Chỉ loại trừ mã sinh tự động; không loại trừ cảnh báo bảo mật của mã nghiệp vụ. -->
<FindBugsFilter>
  <!-- MapStruct sinh *MapperImpl -->
  <Match>
    <Class name="~.*MapperImpl" />
  </Match>
  <!-- Lombok/record DTO: EI_EXPOSE_REP với List/Map trong DTO bất biến theo quy ước dự án -->
  <Match>
    <Package name="~vn\.vnpt\.kpi\..*\.dto" />
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Package name="~vn\.vnpt\.kpi\..*\.model" />
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
  </Match>
  <!-- Spring bean inject qua constructor (Lombok @RequiredArgsConstructor) -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2" />
    <Or>
      <Class name="~.*Service(Impl)?" />
      <Class name="~.*Controller" />
      <Class name="~.*Config" />
    </Or>
  </Match>
</FindBugsFilter>
