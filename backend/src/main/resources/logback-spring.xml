<?xml version="1.0" encoding="UTF-8"?>
<!-- Log JSON có traceId (hỗ trợ từ xa); mask token/ticket/password (PHẦN B §9.7) -->
<configuration>
  <springProperty scope="context" name="APP" source="spring.application.name" defaultValue="kpi-bsc"/>
  <conversionRule conversionWord="masked" class="vn.vnpt.kpi.common.util.MaskingConverter"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] [%X{username:-}] %logger{36} - %masked%n%ex</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>


  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
        <withFormattedMessage>true</withFormattedMessage>
        <withMessage>false</withMessage>
        <withArguments>false</withArguments>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
  <springProfile name="!prod">
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
  </springProfile>
  <logger name="org.apache.poi" level="WARN"/>
  <logger name="org.quartz" level="WARN"/>
</configuration>
