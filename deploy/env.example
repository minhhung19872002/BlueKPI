# /etc/kpi/secrets.env — biến môi trường production (chmod 600, owner root:kpi)
# KHÔNG commit giá trị thật. Ứng dụng từ chối khởi động (StartupSecurityCheck) nếu còn giá trị mặc định/yếu.
# Sinh secret ngẫu nhiên:  openssl rand -base64 64 | tr -d '\n'

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8088

# ---------- CSDL (MariaDB 10.11, primary + replica) ----------
DB_URL=jdbc:mariadb://db01.kpi.local:3306/kpi_bsc
DB_REPLICA_URL=jdbc:mariadb://db02.kpi.local:3306/kpi_bsc
READ_REPLICA_ENABLED=false
DB_SSL_MODE=verify-full
# chỉ quyền DML
DB_USER=kpi_app
DB_PASSWORD=__DOI_MAT_KHAU__
# quyền DDL cho Flyway
DB_MIGRATE_USER=kpi_migrate
DB_MIGRATE_PASSWORD=__DOI_MAT_KHAU__
DB_POOL_MAX=30

# ---------- JWT / phiên ----------
KPI_JWT_SECRET=__CHUOI_NGAU_NHIEN_TOI_THIEU_64_BYTE__
# khóa cũ khi xoay vòng (để trống nếu không có)
KPI_JWT_SECRET_PREVIOUS=
KPI_ACCESS_TTL=15m
KPI_REFRESH_TTL=8h
KPI_IDLE_TIMEOUT=30m
KPI_COOKIE_SECURE=true
KPI_COOKIE_SAMESITE=Lax
KPI_COOKIE_DOMAIN=
KPI_FRONTEND_URL=https://kpi.vnpt.vn/
KPI_CORS_ORIGINS=https://kpi.vnpt.vn
KPI_LOGIN_RATE_LIMIT=10

# Khóa AES-256-GCM cho dữ liệu cá nhân (base64 32 byte): openssl rand -base64 32
KPI_PII_KEY=__BASE64_32_BYTE__

# Tài khoản Admin hệ thống đầu tiên (chỉ dùng lần cài đặt đầu, xóa sau khi đăng nhập & đổi mật khẩu)
KPI_BOOTSTRAP_ADMIN_USERNAME=admin
KPI_BOOTSTRAP_ADMIN_PASSWORD=

# Dữ liệu demo — luôn false ở production
KPI_DEMO_SEED=false

# ---------- SSO CAS VNPT ----------
CAS_ENABLED=true
CAS_SERVER_URL=https://sso.vnpt.vn/cas
CAS_SERVICE_URL=https://kpi.vnpt.vn/api/auth/sso/callback
CAS_PROTOCOL=3.0
CAS_SLO_ENABLED=true
BYPASS_SSO=false

# ---------- MinIO ----------
MINIO_ENDPOINT=https://minio.kpi.local:9000
MINIO_ACCESS_KEY=__ACCESS_KEY__
MINIO_SECRET_KEY=__SECRET_KEY__
MINIO_BUCKET=kpi-files

# ---------- Quét mã độc (ClamAV, tùy chọn) ----------
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---------- Email / Zalo ----------
SMTP_HOST=smtp.vnpt.vn
SMTP_PORT=587
SMTP_USER=kpi-noreply@vnpt.vn
SMTP_PASSWORD=__DOI_MAT_KHAU__
MAIL_FROM=Hệ thống KPI BSC <kpi-noreply@vnpt.vn>
ZALO_ACCESS_TOKEN=

# ---------- Nguồn số liệu KPI (API ngoài) ----------
KPI_SOURCE_API_KEY=
KPI_SOURCE_API_KEY_HEADER=X-API-Key
KPI_SOURCE_BEARER=
KPI_SOURCE_BASIC_USER=
KPI_SOURCE_BASIC_PASSWORD=

# ---------- HRM ----------
HRM_ENABLED=false

# ---------- Swagger (/api/docs) — tắt ở Internet, bật ở mạng nội bộ ----------
SWAGGER_ENABLED=false
